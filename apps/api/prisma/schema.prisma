// Anyform database schema (PostgreSQL).
//
// Status / plan / interval columns are plain strings validated in code (see
// @anyform/shared) so the schema stays portable and migrations stay boring.

generator client {
  provider = "prisma-client-js"
}

// The URL lives in prisma.config.ts (CLI) and src/db.ts (runtime adapter).
datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  /// When the owner last proved they read mail at `email` (verify link or password reset). Null after an email change.
  emailVerifiedAt  DateTime?
  passwordHash     String
  name             String?
  /// "free" | "starter" | "pro" | "business" — denormalised from Subscription for fast quota checks.
  plan             String   @default("free")
  stripeCustomerId String?  @unique
  paddleCustomerId String?  @unique
  /// Conversion-pack credits left; spent after the free allowance, never expire.
  credits          Int      @default(0)
  /// End of a 24-hour pass (Starter limits while in the future).
  passUntil        DateTime?
  /// Bumped on password change/reset; sessions carrying an older value are rejected.
  sessionVersion   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  conversions    Conversion[]
  subscription   Subscription?
  apiKeys        ApiKey[]
  passwordResets PasswordReset[]
  emailVerifications EmailVerification[]
  purchases      Purchase[]
}

/// One-time purchases (conversion pack, 24-hour pass). The provider's
/// transaction id is unique, so a re-delivered webhook can't grant twice.
model Purchase {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "paddle" | "stripe"
  provider              String
  providerTransactionId String    @unique
  /// "pack" | "pass"
  product               String
  credits               Int       @default(0)
  passUntil             DateTime?
  createdAt             DateTime  @default(now())

  @@index([userId, createdAt])
}

/// One-time password-reset link. Only the SHA-256 of the token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// One-time email-verification link, bound to the address it was sent to. Only the SHA-256 of the token is stored.
model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Billing-provider subscription id (Stripe today; adapter-agnostic name on purpose).
  providerSubscriptionId String @unique
  providerPriceId      String
  plan                 String
  /// "month" | "year"
  interval             String
  /// active | trialing | past_due | canceled | incomplete | unpaid
  status               String
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  /// Provider time of the last applied event; older events are dropped.
  providerUpdatedAt    DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Conversion {
  id          String    @id @default(cuid())
  /// Set once the visitor is logged in (or after guest → account merge).
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Anonymous visitor id from the signed guest cookie. Cleared on merge.
  guestId     String?
  /// queued | processing | done | failed
  status      String    @default("queued")
  progress    Int       @default(0)
  sourceName  String
  /// What paid for it: "free" (allowance) | "credit" (pack) | "credit_refunded" | "pass" | "plan".
  chargedAs   String    @default("free")
  sourceExt   String
  targetExt   String
  sourceBytes BigInt
  outputBytes BigInt?
  /// Storage keys (path in the local driver, object key in S3).
  sourceKey   String
  outputKey   String?
  outputName  String?
  /// Which engine produced the output: ffmpeg | sharp | libreoffice | pandoc | calibre | poppler | pdf-lib
  engine      String?
  error       String?
  options     Json?
  /// Client IP hash, used for abuse throttling only.
  ipHash      String?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  /// When the source and output become eligible for deletion.
  expiresAt   DateTime

  @@index([userId, createdAt])
  @@index([guestId, createdAt])
  @@index([status])
  @@index([expiresAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// First 8 chars of the key, shown in the dashboard so users can tell keys apart.
  prefix     String
  keyHash    String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}
