# ─── Anyform environment ────────────────────────────────────────────────────
# Copy to .env at the repo root. docker-compose and both apps read this file.

NODE_ENV=development

# Postgres (also used by pg-boss as the job queue)
DATABASE_URL=postgresql://anyform:anyform@localhost:5432/anyform

# API
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# Proxies whose X-Forwarded-For is trusted (proxy-addr syntax). Never add public ranges.
TRUST_PROXY=loopback,linklocal,uniquelocal
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-to-another-long-random-string
# Set to .anyform.app in production so web and api subdomains share cookies
COOKIE_DOMAIN=

# Storage: "local" (disk, shared volume between api and worker) or "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data
# S3 / MinIO / Cloudflare R2 (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=anyform
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Quotas
FREE_CONVERSIONS=10
FREE_QUOTA_PERIOD=lifetime   # lifetime | monthly
# Abuse limits
GUEST_UPLOADS_PER_HOUR=20
GLOBAL_RATE_LIMIT_PER_MINUTE=100

# Conversion engines (leave blank to auto-detect on PATH / bundled binaries)
FFMPEG_PATH=
SOFFICE_PATH=
PANDOC_PATH=
CALIBRE_PATH=
PDFTOPPM_PATH=
PDFTOTEXT_PATH=
PDFTOHTML_PATH=
MAGICK_PATH=
WORKER_CONCURRENCY=2
JOB_TIMEOUT_MS=900000
# Cron for deleting expired files (default every 10 minutes)
CLEANUP_CRON=*/10 * * * *

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_YEARLY=price_...
STRIPE_PRICE_PACK=price_...
STRIPE_PRICE_PASS=price_...

# Paddle (merchant of record: handles VAT/US sales tax, pays out to Georgia).
# BILLING_PROVIDER picks paddle|stripe; unset = Paddle if PADDLE_API_KEY is set, else Stripe.
# Create products/prices with: node scripts/paddle-setup.mjs (prints the PADDLE_PRICE_* lines)
BILLING_PROVIDER=
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
PADDLE_PRICE_STARTER_MONTHLY=pri_...
PADDLE_PRICE_STARTER_YEARLY=pri_...
PADDLE_PRICE_PRO_MONTHLY=pri_...
PADDLE_PRICE_PRO_YEARLY=pri_...
PADDLE_PRICE_BUSINESS_MONTHLY=pri_...
PADDLE_PRICE_BUSINESS_YEARLY=pri_...
PADDLE_PRICE_PACK=pri_...
PADDLE_PRICE_PASS=pri_...

# Transactional email (password reset links)
# "log" prints each email to the API log instead of sending it (development).
MAIL_DRIVER=log
MAIL_FROM=Anyform <no-reply@anyform.app>
RESEND_API_KEY=

# Web (Next.js)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Paddle.js client-side token (Developer tools → Authentication); safe to expose
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
NEXT_PUBLIC_PADDLE_ENV=sandbox
API_INTERNAL_URL=http://localhost:4000
